{
  "name": "global-free-iptv",
  "version": "1.0.0",
  "description": "A fully functional IPTV streaming application optimized for low-bandwidth environments. Stream live TV channels from Pakistan, India, and around the world.",
  "main": "index.html",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "serve": "npx http-server -p 8000",
    "dev": "npx live-server --port=8000",
    "deploy:netlify": "netlify deploy --prod",
    "deploy:vercel": "vercel --prod"
  },
